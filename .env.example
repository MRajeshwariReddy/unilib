# Client Environment Variables (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COPYRIGHT_CONTACT_EMAIL=copyright@unilib.local

# Server-only Environment Variables (secrets - NEVER prefix with NEXT_PUBLIC_)
AI_ENABLED=true
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=
OPENALEX_API_KEY=

# Optional AI Configuration Overrides
AI_FULL_CONTEXT_MAX_CHARS=100000
AI_RETRIEVAL_TOP_K=8
AI_RATE_LIMIT_PER_HOUR=15
AI_RATE_LIMIT_PER_DAY=60
AI_MAX_OUTPUT_TOKENS=1500
AI_TIMEOUT_MS=45000
